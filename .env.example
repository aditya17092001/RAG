# Copy this file to .env and fill in real values.
# .env is gitignored and never committed.

# JWT - use a long random string (256+ bits for HS256)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits
JWT_EXPIRY=86400000

# Gmail SMTP - generate an App Password at https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
# OpenRouter (used by the 'prod' profile for chat) - get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Cloud PostgreSQL (used by the 'prod' profile). Convert your provider's
# libpq URL (postgres://user:pass@host:port/db) to JDBC form below.
DB_URL=jdbc:postgresql://your-host:5432/defaultdb?sslmode=require
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# Vector DB - separate cloud PostgreSQL with the pgvector extension.
# Convert the provider's libpq URL to JDBC form (jdbc:postgresql://...).
VECTOR_DB_URL=jdbc:postgresql://your-vector-host:5432/defaultdb?sslmode=require
VECTOR_DB_USERNAME=your-db-user
VECTOR_DB_PASSWORD=your-db-password

# Google Gemini API key (embeddings) - free tier from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# OTP email verification toggle. true = send/verify OTP (needs working email);
# false = skip OTP (use on hosts that block SMTP, e.g. Render).
OTP_ENABLED=true

# CORS allowed origins (comma-separated, patterns allowed). Leave unset to use
# the defaults (localhost + *.onrender.com / *.netlify.app / *.vercel.app), or
# pin your exact frontend URL, e.g. https://your-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://*.onrender.com

# OpenRouter chat model ID (prod chat). OpenRouter rotates free models often;
# if chat returns "404: Unknown", pick a current one from https://openrouter.ai/models
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
